{
  "appId": "com.carinventory.app",
  "appName": "Car Inventory",
  "webDir": "staticfiles",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "overrideUserAgent": "CarInventoryApp/1.0 Capacitor",
    "appendUserAgent": " DevMode"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}

