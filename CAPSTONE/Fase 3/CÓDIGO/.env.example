# Django Configuration
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Windows Mode (set to False in Docker/Linux)
WINDOWS_MODE=False

# OpenAI Configuration (Required for voice transcription and AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Vosk Configuration (Voice recognition)
VOSK_MODEL_PATH=/app/vosk-models/vosk-model-es-0.42
VOSK_FEED_MIN_SAMPLES=1600
VOSK_FEED_MAX_INTERVAL_MS=150
VOSK_TRANSCRIPCION_ACTIVA=true

# Redis Configuration (WebSocket support)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Public IP for WebRTC (Update with your server IP)
PUBLIC_IP=your-server-ip-here
